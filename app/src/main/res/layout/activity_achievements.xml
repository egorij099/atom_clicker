<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/achievements_title"
            android:textSize="28sp"
            android:textColor="@color/blue"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"
            android:gravity="center"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@color/card_bg"
            android:padding="16dp"
            android:layout_marginBottom="24dp"
            android:elevation="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/achievement_progress"
                android:textSize="16sp"
                android:textColor="@color/white"/>

            <TextView
                android:id="@+id/tvAchievementProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0/2"
                android:textSize="16sp"
                android:textColor="@color/green"
                android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/achievement1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/card_bg"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:elevation="2dp">

            <ImageView
                android:id="@+id/ivAchievement1"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_achievement"
                android:tint="@color/gray"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="16dp">

                <TextView
                    android:id="@+id/tvAchievement1Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/first_click"
                    android:textSize="16sp"
                    android:textColor="@color/white"/>

                <TextView
                    android:id="@+id/tvAchievement1Desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/first_click_desc"
                    android:textSize="12sp"
                    android:textColor="@color/gray"/>

                <TextView
                    android:id="@+id/tvAchievement1Reward"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/reward_format"
                    android:textSize="12sp"
                    android:textColor="@color/orange"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <Button
                android:id="@+id/btnClaimAchievement1"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/claim"
                android:textSize="12sp"
                android:enabled="false"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/achievement2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/card_bg"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:elevation="2dp">

            <ImageView
                android:id="@+id/ivAchievement2"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_achievement"
                android:tint="@color/gray"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="16dp">

                <TextView
                    android:id="@+id/tvAchievement2Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/hundred_clicks"
                    android:textSize="16sp"
                    android:textColor="@color/white"/>

                <TextView
                    android:id="@+id/tvAchievement2Desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/hundred_clicks_desc"
                    android:textSize="12sp"
                    android:textColor="@color/gray"/>

                <TextView
                    android:id="@+id/tvAchievement2Reward"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/reward_format"
                    android:textSize="12sp"
                    android:textColor="@color/orange"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <Button
                android:id="@+id/btnClaimAchievement2"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/claim"
                android:textSize="12sp"
                android:enabled="false"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/achievements_info"
            android:textSize="12sp"
            android:textColor="@color/gray"
            android:gravity="center"
            android:layout_marginTop="16dp"/>
    </LinearLayout>
</ScrollView>